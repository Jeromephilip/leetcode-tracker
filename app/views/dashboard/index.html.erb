<!DOCTYPE html>
<html>
<head>
  <title>Dashboard - <%= @user.leetcode_username %></title>
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f8f9fa;
      color: #333;
      line-height: 1.6;
      margin: 0;
      padding: 0;
      height: 100vh;
      overflow: hidden;
    }

    .dashboard-layout {
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
      width: 60px;
      background: white;
      border-right: 1px solid #e9ecef;
      padding: 20px 0;
      position: fixed;
      height: 100vh;
      z-index: 100;
    }

    .sidebar-icon {
      display: block;
      width: 40px;
      height: 40px;
      margin: 10px auto;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #6c757d;
      transition: all 0.2s ease;
    }

    .sidebar-icon:hover {
      background: #f8f9fa;
      color: #6f42c1;
    }

    .sidebar-icon.active {
      background: #6f42c1;
      color: white;
    }

    .sidebar-icon svg {
      width: 20px;
      height: 20px;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      margin-left: 60px;
      padding: 30px;
      display: flex;
      flex-direction: column;
      min-height: calc(100vh - 60px);
      margin-top: 60px;
      overflow-y: auto;
      box-sizing: border-box;
    }

    /* Header */
    .header {
      margin-bottom: 30px;
      flex-shrink: 0;
    }

    .header h1 {
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 8px;
      color: #333;
    }

    .header p {
      color: #6c757d;
      font-size: 1rem;
    }

    /* Top Bar */
    .top-bar {
      position: fixed;
      top: 0;
      right: 0;
      left: 60px;
      height: 60px;
      background: white;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 30px;
      z-index: 99;
    }

    .user-menu {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #6c757d;
      cursor: pointer;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #6f42c1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 14px;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
      flex-shrink: 0;
    }

    .stat-card {
      background: white;
      padding: 24px;
      border-radius: 12px;
      border: 1px solid #e9ecef;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .stat-card.featured {
      background: linear-gradient(135deg, #6f42c1 0%, #8b5cf6 100%);
      color: white;
    }

    .stat-card.featured .stat-number {
      color: white;
    }

    .stat-card.featured .stat-label {
      color: rgba(255, 255, 255, 0.8);
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #6f42c1;
      margin-bottom: 8px;
    }

    .stat-label {
      color: #6c757d;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 500;
    }

    .stat-description {
      font-size: 0.875rem;
      color: #6c757d;
      margin-top: 8px;
    }

    .stat-card.featured .stat-description {
      color: rgba(255, 255, 255, 0.9);
    }

    .view-button {
      background: rgba(255, 255, 255, 0.2);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      margin-top: 12px;
      transition: background 0.2s ease;
    }

    .view-button:hover {
      background: rgba(255, 255, 255, 0.3);
    }


    .section-header {
      padding: 20px 24px;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: #333;
    }

    .btn {
      padding: 8px 16px;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: #6f42c1;
      color: white;
    }

    .btn-primary:hover {
      background: #5a32a3;
    }

    /* Section */
    .section {
      background: white;
      border-radius: 12px;
      border: 1px solid #e9ecef;
      overflow: hidden;
      margin-bottom: 30px;
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
    }

    /* Table */
    .table-container {
      overflow-x: auto;
      overflow-y: auto;
      flex: 1;
      min-height: 0;
      padding-bottom: 20px;
    }

    .table-container::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    .table-container::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 4px;
    }

    .table-container::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 4px;
    }

    .table-container::-webkit-scrollbar-thumb:hover {
      background: #a8a8a8;
    }

    .submissions-table {
      width: 100%;
      border-collapse: collapse;
    }

    .submissions-table th,
    .submissions-table td {
      padding: 12px 24px;
      text-align: left;
      border-bottom: 1px solid #e9ecef;
    }

    .submissions-table th {
      font-weight: 600;
      color: #6c757d;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #f8f9fa;
    }

    .submissions-table tbody tr:hover {
      background: #f8f9fa;
    }

    .submissions-table tbody tr:last-child td {
      border-bottom: none;
    }

    .problem-link {
      color: #6f42c1;
      text-decoration: none;
      font-weight: 500;
    }

    .problem-link:hover {
      text-decoration: underline;
    }

    .status-badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-accepted {
      background: #d4edda;
      color: #155724;
    }

    .status-wrong {
      background: #f8d7da;
      color: #721c24;
    }

    .status-pending {
      background: #fff3cd;
      color: #856404;
    }

    .language-tag {
      background: #e9ecef;
      color: #495057;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
    }

    /* Error States */
    .error-message {
      background: #f8d7da;
      color: #721c24;
      padding: 20px;
      border-radius: 8px;
      border: 1px solid #f5c6cb;
      margin-bottom: 20px;
    }

    .link-account-section {
      background: #e7f3ff;
      border: 1px solid #b3d9ff;
      border-radius: 8px;
      padding: 25px;
      text-align: center;
      margin-bottom: 30px;
    }

    .link-account-section h3 {
      color: #004085;
      margin-bottom: 15px;
    }

    .link-account-section p {
      color: #004085;
      margin-bottom: 20px;
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #6c757d;
    }

    .empty-state h3 {
      margin-bottom: 10px;
      color: #333;
    }

    /* Review Tasks Styles */
    .review-tasks-container {
      display: grid;
      gap: 12px;
      flex-grow: 1;
      max-height: calc(3 * (140px + 12px) - 12px); /* 3 cards + gaps - last gap */
      overflow-y: auto;
      padding: 20px;
    }

    .review-tasks-container::-webkit-scrollbar {
      width: 6px;
    }

    .review-tasks-container::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 3px;
    }

    .review-tasks-container::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 3px;
    }

    .review-tasks-container::-webkit-scrollbar-thumb:hover {
      background: #a8a8a8;
    }


    .review-task-card {
      background: white;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      padding: 18px;
      transition: all 0.2s ease;
      min-height: 140px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .review-task-card:hover {
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      border-color: #6f42c1;
    }

    .stat-badge.tomorrow {
      background: #e3f2fd;
      color: #1565c0;
    }

    /* Sections Grid for horizontal layout */
    .sections-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
      margin-bottom: 30px;
    }

    .sections-grid .section {
      margin-bottom: 0;
    }

    /* Responsive design for smaller screens */
    @media (max-width: 768px) {
      .sections-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
    }

    .task-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }

    .task-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: #333;
      margin: 0;
    }

    .task-meta {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .difficulty-badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .difficulty-1 { background: #d4edda; color: #155724; }
    .difficulty-2 { background: #fff3cd; color: #856404; }
    .difficulty-3 { background: #f8d7da; color: #721c24; }

    .review-count {
      font-size: 0.875rem;
      color: #6c757d;
    }

    .task-details {
      margin-bottom: 12px;
      flex-grow: 1;
      min-height: 0;
    }

    .interval-info {
      display: flex;
      gap: 8px;
      margin-bottom: 6px;
    }

    .interval-label {
      font-size: 0.875rem;
      color: #6c757d;
    }

    .interval-value {
      font-size: 0.875rem;
      font-weight: 600;
      color: #6f42c1;
    }

    .overdue-warning {
      color: #dc3545;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .review-actions {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-shrink: 0;
      margin-top: auto;
    }

    .review-btn {
      background: #6f42c1;
      color: white;
      border: none;
      padding: 8px 14px;
      border-radius: 5px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .review-btn:hover {
      background: #5a32a3;
    }

    .leetcode-link {
      color: #6f42c1;
      text-decoration: none;
      font-size: 0.875rem;
    }

    .leetcode-link:hover {
      text-decoration: underline;
    }

    /* Modal Styles */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background: white;
      border-radius: 12px;
      max-width: 600px;
      width: 90%;
      max-height: 80vh;
      overflow-y: auto;
    }

    .modal-header {
      padding: 20px 24px;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-header h3 {
      margin: 0;
      color: #333;
    }

    .close-modal {
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: #6c757d;
    }

    .modal-body {
      padding: 24px;
    }

    .quality-buttons {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      width: 100%;
    }

    .quality-btn {
      background: white;
      border: 2px solid #e9ecef;
      border-radius: 50%;
      width: 80px;
      height: 80px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .quality-btn:hover {
      border-color: #6f42c1;
      background: #f8f9fa;
      transform: translateY(-2px);
    }

    .quality-label {
      font-size: 0.75rem;
      color: #333;
      font-weight: 500;
      text-align: center;
      line-height: 1.2;
    }

    .quality-number {
      position: absolute;
      bottom: -25px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.875rem;
      font-weight: 600;
      color: #6f42c1;
    }

    .review-stats {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .stat-badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      background: #e9ecef;
      color: #495057;
    }

    .stat-badge.overdue {
      background: #f8d7da;
      color: #721c24;
    }

    /* Completed State Styles */
    .completed-state {
      text-align: center;
      padding: 40px 20px;
      color: #6c757d;
    }

    .completed-icon {
      color: #28a745;
      margin-bottom: 16px;
    }

    .completed-state h3 {
      color: #28a745;
      margin-bottom: 8px;
      font-size: 1.5rem;
      font-weight: 600;
    }

    .completed-state p {
      margin-bottom: 20px;
      font-size: 1rem;
    }

    .completion-stats {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
    }

    .stat-item {
      background: #e9ecef;
      color: #495057;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.875rem;
      font-weight: 500;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .main-content {
        margin-left: 0;
        padding: 20px;
      }

      .top-bar {
        left: 0;
      }

      .sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .task-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }

      .review-actions {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }

      .quality-buttons {
        gap: 4px;
      }

      .quality-btn {
        width: 60px;
        height: 60px;
      }

      .quality-label {
        font-size: 0.65rem;
      }

      .quality-number {
        font-size: 0.75rem;
        bottom: -20px;
      }

      .completion-stats {
        flex-direction: column;
        gap: 10px;
      }

      .review-tasks-container {
        max-height: 300px;
        padding: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <!-- Sidebar -->
    <nav class="sidebar">
      <a href="/dashboard" class="sidebar-icon active" title="Dashboard">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
        </svg>
      </a>
      <a href="/problems" class="sidebar-icon" title="Problems">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </a>
      <a href="/logout" class="sidebar-icon" title="Logout">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.59L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
        </svg>
      </a>
    </nav>

    <!-- Top Bar -->
    <div class="top-bar">
      <div class="user-menu">
        <div class="user-avatar">
          <%= (@user.leetcode_username || @user.email).first.upcase %>
        </div>
        <span><%= @user.leetcode_username || @user.email %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 10l5 5 5-5z"/>
        </svg>
      </div>
    </div>

    <!-- Main Content -->
    <main class="main-content" style="margin-top: 60px;">
      <div class="header">
        <h1>Dashboard</h1>
        <p>Track your LeetCode progress and monitor your coding journey.</p>
      </div>

      <% if @error %>
        <div class="error-message">
          <h3>Error</h3>
          <p><%= @error %></p>
          <p>Please try linking your LeetCode account again.</p>
        </div>
      <% end %>

      <% if @user.leetcode_cookies.nil? %>
        <div class="link-account-section">
          <h3>Link Your LeetCode Account</h3>
          <p>To view your LeetCode statistics and recent submissions, you need to link your LeetCode account first.</p>
          <a href="/dashboard/link_account" class="btn btn-primary">Link Account</a>
        </div>
      <% else %>
        <!-- Stats Grid -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-number"><%= @leetcode_stats[:solved_count] || 0 %></div>
            <div class="stat-label">Problems Solved</div>
            <div class="stat-description">Total accepted solutions</div>
          </div>
          
          <% if @review_stats[:total_problems] > 0 %>
            <div class="stat-card">
              <div class="stat-number"><%= @review_stats[:mastered] %></div>
              <div class="stat-label">Mastered</div>
              <div class="stat-description"><%= @review_stats[:mastery_rate] %>% mastery rate</div>
            </div>
          <% end %>
        </div>

        <!-- Review Tasks Sections -->
        <% if @user.leetcode_cookies.present? %>
          <div class="sections-grid">
            <!-- Today's Review Tasks -->
            <div class="section">
              <div class="section-header">
                <h2 class="section-title">Today's Tasks</h2>
                <div class="review-stats">
                  <% if @todays_review_tasks&.any? %>
                    <span class="stat-badge"><%= @review_stats[:due_today] %> due</span>
                    <% if @review_stats[:overdue] > 0 %>
                      <span class="stat-badge overdue"><%= @review_stats[:overdue] %> overdue</span>
                    <% end %>
                  <% end %>
                </div>
              </div>
              
              <% if @todays_review_tasks&.any? %>
                <div class="review-tasks-container">
                  <% @todays_review_tasks.each do |task| %>
                    <div class="review-task-card" data-entry-id="<%= task.id %>">
                      <div class="task-header">
                        <h3 class="task-title"><%= task.problem_title %></h3>
                        <div class="task-meta">
                          <span class="difficulty-badge difficulty-<%= task.difficulty_level %>">
                            <%= task.difficulty_name %>
                          </span>
                          <span class="review-count">Review #<%= task.review_count + 1 %></span>
                        </div>
                      </div>
                      
                      <div class="task-details">
                        <div class="interval-info">
                          <span class="interval-label">Next interval:</span>
                          <span class="interval-value"><%= task.interval_days %> days</span>
                        </div>
                        <% if task.overdue_days > 0 %>
                          <div class="overdue-warning">
                            <%= task.overdue_days %> days overdue
                          </div>
                        <% end %>
                      </div>
                      
                      <div class="review-actions">
                        <button class="review-btn" onclick="openReviewModal(<%= task.id %>)">
                          Start Review
                        </button>
                        <a href="https://leetcode.com/problems/<%= task.problem_slug %>" 
                           target="_blank" class="leetcode-link">
                          View on LeetCode
                        </a>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% elsif @review_stats[:total_problems] > 0 %>
                <div class="completed-state">
                  <div class="completed-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 11l3 3l8-8"></path>
                      <path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9s4.03-9 9-9c2.12 0 4.07.74 5.62 1.97"></path>
                    </svg>
                  </div>
                  <h3>All caught up!</h3>
                  <p>You've completed all your review tasks for today. Great job!</p>
                  <div class="completion-stats">
                    <span class="stat-item"><%= @review_stats[:total_problems] %> problems in system</span>
                    <span class="stat-item"><%= @review_stats[:mastered] %> mastered</span>
                  </div>
                </div>
              <% else %>
                <div class="empty-state">
                  <h3>No problems synced yet</h3>
                  <p>Click "Sync Problems" to add your solved problems to spaced repetition review.</p>
                </div>
              <% end %>
            </div>

          </div>
        <% end %>

        <!-- Recent Submissions Table -->
        <div class="section">
          <div class="section-header">
            <h2 class="section-title">Recent Submissions</h2>
            <button id="sync-data-btn" class="btn btn-primary" onclick="syncSubmissions()">Sync Data</button>
          </div>
          
          <div class="table-container">
            <% if @recent_submissions&.any? %>
              <table class="submissions-table">
                <thead>
                  <tr>
                    <th>Problem</th>
                    <th>Status</th>
                    <th>Language</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_submissions.each do |submission| %>
                    <tr>
                      <td>
                        <a href="<%= submission.url %>" target="_blank" class="problem-link">
                          <%= submission.title %>
                        </a>
                      </td>
                      <td>
                        <span class="status-badge status-<%= submission.status.downcase %>">
                          <%= submission.status %>
                        </span>
                      </td>
                      <td>
                        <span class="language-tag"><%= submission.language %></span>
                      </td>
                      <td><%= format_submission_time(submission.submitted_at) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <div class="empty-state">
                <h3>No submissions loaded</h3>
                <p>Click "Sync Data" to fetch your recent submissions from LeetCode.</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </main>
  </div>

  <!-- Review Modal -->
  <div id="reviewModal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>How well could you solve this problem?</h3>
        <button class="close-modal" onclick="closeReviewModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="quality-buttons">
          <button class="quality-btn" data-quality="1" onclick="submitReview(1)">
            <span class="quality-label">Could not solve</span>
            <span class="quality-number">1</span>
          </button>
          <button class="quality-btn" data-quality="2" onclick="submitReview(2)">
            <span class="quality-label">Solved with major hints</span>
            <span class="quality-number">2</span>
          </button>
          <button class="quality-btn" data-quality="3" onclick="submitReview(3)">
            <span class="quality-label">Solved with minor hints</span>
            <span class="quality-number">3</span>
          </button>
          <button class="quality-btn" data-quality="4" onclick="submitReview(4)">
            <span class="quality-label">Solved independently</span>
            <span class="quality-number">4</span>
          </button>
          <button class="quality-btn" data-quality="5" onclick="submitReview(5)">
            <span class="quality-label">Solved easily</span>
            <span class="quality-number">5</span>
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <script>
    function syncSubmissions() {
      const syncButton = document.getElementById('sync-data-btn');
      const originalText = syncButton.textContent;
      
      // Show loading state
      syncButton.disabled = true;
      syncButton.textContent = 'Syncing...';
      
      // Get CSRF token
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
      
      fetch('/api/v1/leetcode/sync_submissions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        credentials: 'same-origin'
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Update the page
          location.reload();
        } else {
          if (data.requires_relink) {
            showMessage('LeetCode session expired. Please re-link your account.', 'error');
            setTimeout(() => {
              if (confirm('Your LeetCode session has expired. Would you like to re-link your account?')) {
                window.location.href = '/dashboard/link_account';
              }
            }, 2000);
          } else {
            showMessage(data.error || 'Failed to sync data', 'error');
          }
        }
      })
      .catch(error => {
        console.error('Sync error:', error);
        showMessage('An error occurred while syncing. Please try again.', 'error');
      })
      .finally(() => {
        syncButton.disabled = false;
        syncButton.textContent = originalText;
      });
    }
    
    function showMessage(message, type) {
      const messageEl = document.createElement('div');
      messageEl.style.cssText = `
        position: fixed;
        top: 80px;
        right: 20px;
        padding: 15px 20px;
        border-radius: 6px;
        color: white;
        font-weight: 500;
        z-index: 1000;
        animation: slideIn 0.3s ease-out;
        ${type === 'success' ? 'background: #28a745;' : 'background: #dc3545;'}
      `;
      messageEl.textContent = message;
      
      document.body.appendChild(messageEl);
      
      setTimeout(() => {
        if (messageEl.parentNode) {
          messageEl.remove();
        }
      }, 3000);
    }

    // Spaced Repetition Functions
    let currentReviewEntryId = null;

    function openReviewModal(entryId) {
      currentReviewEntryId = entryId;
      document.getElementById('reviewModal').style.display = 'flex';
    }

    function closeReviewModal() {
      document.getElementById('reviewModal').style.display = 'none';
      currentReviewEntryId = null;
    }

    function submitReview(qualityScore) {
      if (!currentReviewEntryId) return;
      
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
      
      fetch('/api/v1/spaced_repetition/review', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
          entry_id: currentReviewEntryId,
          quality_score: qualityScore
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          showMessage('Review submitted successfully!', 'success');
          // Remove the reviewed task from the UI
          const taskCard = document.querySelector(`[data-entry-id="${currentReviewEntryId}"]`);
          if (taskCard) {
            taskCard.style.opacity = '0.5';
            taskCard.style.pointerEvents = 'none';
            // Update the review count
            const reviewCountElement = taskCard.querySelector('.review-count');
            if (reviewCountElement) {
              reviewCountElement.textContent = `Review #${data.review_count + 1}`;
            }
          }
          closeReviewModal();
          
          // Refresh the page after a short delay to update stats
          setTimeout(() => {
            location.reload();
          }, 1500);
        } else {
          showMessage(data.error || 'Failed to submit review', 'error');
        }
      })
      .catch(error => {
        console.error('Review error:', error);
        showMessage('An error occurred while submitting review', 'error');
      });
    }

    function syncSpacedRepetition() {
      const syncButton = document.getElementById('sync-problems-btn');
      const originalText = syncButton.textContent;
      
      // Show loading state
      syncButton.disabled = true;
      syncButton.textContent = 'Syncing...';
      
      // Get CSRF token
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
      
      fetch('/api/v1/spaced_repetition/sync', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        credentials: 'same-origin'
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          showMessage(`Synced ${data.created_count} new problems for spaced repetition!`, 'success');

          setTimeout(() => {
            location.reload();
          }, 1500);
        } else {
          showMessage(data.error || 'Failed to sync problems', 'error');
        }
      })
      .catch(error => {
        console.error('Sync error:', error);
        showMessage('An error occurred while syncing. Please try again.', 'error');
      })
      .finally(() => {
        syncButton.disabled = false;
        syncButton.textContent = originalText;
      });
    }

    // Close modal when clicking outside
    document.getElementById('reviewModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeReviewModal();
      }
    });
  </script>
</body>
</html>
