<!DOCTYPE html>
<html>
<head>
  <title>Dashboard - <%= @user.leetcode_username %></title>
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f8f9fa;
      color: #333;
      line-height: 1.6;
    }

    .dashboard-layout {
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
      width: 60px;
      background: white;
      border-right: 1px solid #e9ecef;
      padding: 20px 0;
      position: fixed;
      height: 100vh;
      z-index: 100;
    }

    .sidebar-icon {
      display: block;
      width: 40px;
      height: 40px;
      margin: 10px auto;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #6c757d;
      transition: all 0.2s ease;
    }

    .sidebar-icon:hover {
      background: #f8f9fa;
      color: #6f42c1;
    }

    .sidebar-icon.active {
      background: #6f42c1;
      color: white;
    }

    .sidebar-icon svg {
      width: 20px;
      height: 20px;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      margin-left: 60px;
      padding: 30px;
    }

    /* Header */
    .header {
      margin-bottom: 30px;
    }

    .header h1 {
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 8px;
      color: #333;
    }

    .header p {
      color: #6c757d;
      font-size: 1rem;
    }

    /* Top Bar */
    .top-bar {
      position: fixed;
      top: 0;
      right: 0;
      left: 60px;
      height: 60px;
      background: white;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 30px;
      z-index: 99;
    }

    .user-menu {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #6c757d;
      cursor: pointer;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #6f42c1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 14px;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .stat-card {
      background: white;
      padding: 24px;
      border-radius: 12px;
      border: 1px solid #e9ecef;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .stat-card.featured {
      background: linear-gradient(135deg, #6f42c1 0%, #8b5cf6 100%);
      color: white;
    }

    .stat-card.featured .stat-number {
      color: white;
    }

    .stat-card.featured .stat-label {
      color: rgba(255, 255, 255, 0.8);
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #6f42c1;
      margin-bottom: 8px;
    }

    .stat-label {
      color: #6c757d;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 500;
    }

    .stat-description {
      font-size: 0.875rem;
      color: #6c757d;
      margin-top: 8px;
    }

    .stat-card.featured .stat-description {
      color: rgba(255, 255, 255, 0.9);
    }

    .view-button {
      background: rgba(255, 255, 255, 0.2);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      margin-top: 12px;
      transition: background 0.2s ease;
    }

    .view-button:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    /* Section */
    .section {
      background: white;
      border-radius: 12px;
      border: 1px solid #e9ecef;
      overflow: hidden;
      margin-bottom: 30px;
    }

    .section-header {
      padding: 20px 24px;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: #333;
    }

    .btn {
      padding: 8px 16px;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: #6f42c1;
      color: white;
    }

    .btn-primary:hover {
      background: #5a32a3;
    }

    /* Table */
    .table-container {
      overflow-x: auto;
    }

    .submissions-table {
      width: 100%;
      border-collapse: collapse;
    }

    .submissions-table th,
    .submissions-table td {
      padding: 12px 24px;
      text-align: left;
      border-bottom: 1px solid #e9ecef;
    }

    .submissions-table th {
      font-weight: 600;
      color: #6c757d;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #f8f9fa;
    }

    .submissions-table tbody tr:hover {
      background: #f8f9fa;
    }

    .submissions-table tbody tr:last-child td {
      border-bottom: none;
    }

    .problem-link {
      color: #6f42c1;
      text-decoration: none;
      font-weight: 500;
    }

    .problem-link:hover {
      text-decoration: underline;
    }

    .status-badge {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-accepted {
      background: #d4edda;
      color: #155724;
    }

    .status-wrong {
      background: #f8d7da;
      color: #721c24;
    }

    .status-pending {
      background: #fff3cd;
      color: #856404;
    }

    .language-tag {
      background: #e9ecef;
      color: #495057;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
    }

    /* Error States */
    .error-message {
      background: #f8d7da;
      color: #721c24;
      padding: 20px;
      border-radius: 8px;
      border: 1px solid #f5c6cb;
      margin-bottom: 20px;
    }

    .link-account-section {
      background: #e7f3ff;
      border: 1px solid #b3d9ff;
      border-radius: 8px;
      padding: 25px;
      text-align: center;
      margin-bottom: 30px;
    }

    .link-account-section h3 {
      color: #004085;
      margin-bottom: 15px;
    }

    .link-account-section p {
      color: #004085;
      margin-bottom: 20px;
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #6c757d;
    }

    .empty-state h3 {
      margin-bottom: 10px;
      color: #333;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .main-content {
        margin-left: 0;
        padding: 20px;
      }

      .top-bar {
        left: 0;
      }

      .sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <!-- Sidebar -->
    <nav class="sidebar">
      <a href="/dashboard" class="sidebar-icon active" title="Dashboard">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
        </svg>
      </a>
      <a href="/problems" class="sidebar-icon" title="Problems">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </a>
      <a href="/logout" class="sidebar-icon" title="Logout">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.59L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
        </svg>
      </a>
    </nav>

    <!-- Top Bar -->
    <div class="top-bar">
      <div class="user-menu">
        <div class="user-avatar">
          <%= (@user.leetcode_username || @user.email).first.upcase %>
        </div>
        <span><%= @user.leetcode_username || @user.email %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 10l5 5 5-5z"/>
        </svg>
      </div>
    </div>

    <!-- Main Content -->
    <main class="main-content" style="margin-top: 60px;">
      <div class="header">
        <h1>Dashboard</h1>
        <p>Track your LeetCode progress and monitor your coding journey.</p>
      </div>

      <% if @error %>
        <div class="error-message">
          <h3>Error</h3>
          <p><%= @error %></p>
          <p>Please try linking your LeetCode account again.</p>
        </div>
      <% end %>

      <% if @user.leetcode_cookies.nil? %>
        <div class="link-account-section">
          <h3>Link Your LeetCode Account</h3>
          <p>To view your LeetCode statistics and recent submissions, you need to link your LeetCode account first.</p>
          <a href="/dashboard/link_account" class="btn btn-primary">Link Account</a>
        </div>
      <% else %>
        <!-- Stats Grid -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-number"><%= @leetcode_stats[:solved_count] || 0 %></div>
            <div class="stat-label">Problems Solved</div>
            <div class="stat-description">Total accepted solutions</div>
          </div>
          
          <div class="stat-card">
            <div class="stat-number"><%= @leetcode_stats[:total_count] || 0 %></div>
            <div class="stat-label">Total Problems</div>
            <div class="stat-description">Available on platform</div>
          </div>
          
          <div class="stat-card featured">
            <div class="stat-number"><%= @recent_submissions&.length || 0 %></div>
            <div class="stat-label">Recent Submissions</div>
            <div class="stat-description">Last 10 submissions</div>
            <button class="view-button" onclick="syncSubmissions()">Sync →</button>
          </div>
        </div>

        <!-- Recent Submissions Table -->
        <div class="section">
          <div class="section-header">
            <h2 class="section-title">Recent Submissions</h2>
            <button class="btn btn-primary" onclick="syncSubmissions()">Sync Data</button>
          </div>
          
          <div class="table-container">
            <% if @recent_submissions&.any? %>
              <table class="submissions-table">
                <thead>
                  <tr>
                    <th>Problem</th>
                    <th>Status</th>
                    <th>Language</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_submissions.each do |submission| %>
                    <tr>
                      <td>
                        <a href="<%= submission.url %>" target="_blank" class="problem-link">
                          <%= submission.title %>
                        </a>
                      </td>
                      <td>
                        <span class="status-badge status-<%= submission.status.downcase %>">
                          <%= submission.status %>
                        </span>
                      </td>
                      <td>
                        <span class="language-tag"><%= submission.language %></span>
                      </td>
                      <td><%= format_submission_time(submission.submitted_at) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <div class="empty-state">
                <h3>No submissions loaded</h3>
                <p>Click "Sync Data" to fetch your recent submissions from LeetCode.</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </main>
  </div>
  
  <script>
    function syncSubmissions() {
      const syncButton = document.querySelector('.btn-primary');
      const originalText = syncButton.textContent;
      
      // Show loading state
      syncButton.disabled = true;
      syncButton.textContent = 'Syncing...';
      
      // Get CSRF token
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
      
      fetch('/api/v1/leetcode/sync_submissions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        credentials: 'same-origin'
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Update the page
          location.reload();
        } else {
          if (data.requires_relink) {
            showMessage('LeetCode session expired. Please re-link your account.', 'error');
            setTimeout(() => {
              if (confirm('Your LeetCode session has expired. Would you like to re-link your account?')) {
                window.location.href = '/dashboard/link_account';
              }
            }, 2000);
          } else {
            showMessage(data.error || 'Failed to sync data', 'error');
          }
        }
      })
      .catch(error => {
        console.error('Sync error:', error);
        showMessage('An error occurred while syncing. Please try again.', 'error');
      })
      .finally(() => {
        syncButton.disabled = false;
        syncButton.textContent = originalText;
      });
    }
    
    function showMessage(message, type) {
      const messageEl = document.createElement('div');
      messageEl.style.cssText = `
        position: fixed;
        top: 80px;
        right: 20px;
        padding: 15px 20px;
        border-radius: 6px;
        color: white;
        font-weight: 500;
        z-index: 1000;
        animation: slideIn 0.3s ease-out;
        ${type === 'success' ? 'background: #28a745;' : 'background: #dc3545;'}
      `;
      messageEl.textContent = message;
      
      document.body.appendChild(messageEl);
      
      setTimeout(() => {
        if (messageEl.parentNode) {
          messageEl.remove();
        }
      }, 3000);
    }
  </script>
</body>
</html>
