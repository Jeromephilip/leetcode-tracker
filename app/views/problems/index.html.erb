<!DOCTYPE html>
<html>
<head>
  <title>Solved Problems - <%= @user.leetcode_username %></title>
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f8f9fa;
      color: #333;
      line-height: 1.6;
    }

    .dashboard-layout {
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
      width: 60px;
      background: white;
      border-right: 1px solid #e9ecef;
      padding: 20px 0;
      position: fixed;
      height: 100vh;
      z-index: 100;
    }

    .sidebar-icon {
      display: block;
      width: 40px;
      height: 40px;
      margin: 10px auto;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #6c757d;
      transition: all 0.2s ease;
    }

    .sidebar-icon:hover {
      background: #f8f9fa;
      color: #6f42c1;
    }

    .sidebar-icon.active {
      background: #6f42c1;
      color: white;
    }

    .sidebar-icon svg {
      width: 20px;
      height: 20px;
    }

    /* Main Content */
    .main-content {
      flex: 1;
      margin-left: 60px;
      padding: 30px;
    }

    /* Header */
    .header {
      margin-bottom: 30px;
    }

    .header h1 {
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 8px;
      color: #333;
    }

    .header p {
      color: #6c757d;
      font-size: 1rem;
    }

    /* Top Bar */
    .top-bar {
      position: fixed;
      top: 0;
      right: 0;
      left: 60px;
      height: 60px;
      background: white;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 30px;
      z-index: 99;
    }

    .user-menu {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #6c757d;
      cursor: pointer;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #6f42c1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 14px;
    }
    
    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .stat-card {
      background: white;
      padding: 24px;
      border-radius: 12px;
      border: 1px solid #e9ecef;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .stat-card.featured {
      background: linear-gradient(135deg, #6f42c1 0%, #8b5cf6 100%);
      color: white;
    }

    .stat-card.featured .stat-number {
      color: white;
    }

    .stat-card.featured .stat-label {
      color: rgba(255, 255, 255, 0.8);
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #6f42c1;
      margin-bottom: 8px;
    }

    .stat-label {
      color: #6c757d;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 500;
    }

    .stat-description {
      font-size: 0.875rem;
      color: #6c757d;
      margin-top: 8px;
    }

    .stat-card.featured .stat-description {
      color: rgba(255, 255, 255, 0.9);
    }

    .view-button {
      background: rgba(255, 255, 255, 0.2);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      margin-top: 12px;
      transition: background 0.2s ease;
    }

    .view-button:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    /* Section */
    .section {
      background: white;
      border-radius: 12px;
      border: 1px solid #e9ecef;
      overflow: hidden;
      margin-bottom: 30px;
    }

    .section-header {
      padding: 20px 24px;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: #333;
    }

    .btn {
      padding: 8px 16px;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: #6f42c1;
      color: white;
    }

    .btn-primary:hover {
      background: #5a32a3;
    }
    
    .problems-grid {
      display: grid;
      gap: 16px;
    }
    
    .problem-card {
      background: white;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      padding: 20px;
      transition: all 0.3s ease;
      border-left: 4px solid #28a745;
      opacity: 1;
      transform: scale(1);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      min-height: 300px;
      max-width: 100%;
      overflow: hidden;
    }
    
    .problem-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }
    
    .problem-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 15px;
      flex-wrap: wrap;
      gap: 15px;
    }
    
    .problem-title {
      font-size: 1.2em;
      font-weight: 600;
      color: #333;
      text-decoration: none;
      word-wrap: break-word;
      overflow-wrap: break-word;
      max-width: 100%;
    }
    
    .problem-title:hover {
      color: #667eea;
    }
    
    .difficulty-badge {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.75em;
      font-weight: 600;
      text-transform: uppercase;
      white-space: nowrap;
    }
    
    .difficulty-easy {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }
    
    .difficulty-medium {
      background: #fff3cd;
      color: #856404;
      border: 1px solid #ffeaa7;
    }
    
    .difficulty-hard {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
    
    .problem-details {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      color: #6c757d;
      font-size: 0.9em;
      margin-bottom: 15px;
      flex-shrink: 0;
    }
    
    .detail-item {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #f8f9fa;
      padding: 6px 10px;
      border-radius: 6px;
      border: 1px solid #e9ecef;
    }
    
    .notes-section {
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 6px;
      padding: 15px;
      margin-top: 15px;
      height: 120px;
      overflow: hidden;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      max-width: 100%;
    }
    
    .notes-title {
      font-weight: 600;
      color: #333;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .notes-content {
      color: #555;
      line-height: 1.6;
      height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      padding-right: 5px;
      word-wrap: break-word;
      max-width: 100%;
    }

    .notes-content::-webkit-scrollbar {
      width: 6px;
    }

    .notes-content::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 3px;
    }

    .notes-content::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 3px;
    }

    .notes-content::-webkit-scrollbar-thumb:hover {
      background: #a8a8a8;
    }
    
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #6c757d;
    }
    
    .empty-state h3 {
      margin-bottom: 10px;
      color: #333;
    }
    
    .sync-button {
      background: #667eea;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 1em;
      transition: background 0.2s;
    }
    
    .sync-button:hover {
      background: #5a6fd8;
    }
    
    .search-section {
      margin-bottom: 25px;
      padding: 20px;
      background: #f8f9fa;
      border-radius: 8px;
      border: 1px solid #e9ecef;
    }
    
    .search-box {
      margin-bottom: 15px;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    
    .search-input {
      flex: 1;
      padding: 12px 16px;
      border: 2px solid #e9ecef;
      border-radius: 8px;
      font-size: 1em;
      transition: border-color 0.2s;
    }
    
    .clear-filters-btn {
      padding: 12px 16px;
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9em;
      transition: background 0.2s;
      white-space: nowrap;
    }
    
    .clear-filters-btn:hover {
      background: #c82333;
    }
    
    .search-input:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    
    .filter-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    
    .filter-btn {
      padding: 8px 16px;
      border: 2px solid #e9ecef;
      background: white;
      color: #6c757d;
      border-radius: 20px;
      cursor: pointer;
      font-size: 0.9em;
      transition: all 0.2s;
    }
    
    .filter-btn:hover {
      border-color: #667eea;
      color: #667eea;
    }
    
    .filter-btn.active {
      background: #667eea;
      border-color: #667eea;
      color: white;
    }
    
    .problems-grid {
      max-height: 600px;
      overflow-y: auto;
      padding-right: 10px;
    }
    
    .problems-grid::-webkit-scrollbar {
      width: 8px;
    }
    
    .problems-grid::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 4px;
    }
    
    .problems-grid::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 4px;
    }
    
    .problems-grid::-webkit-scrollbar-thumb:hover {
      background: #a8a8a8;
    }
    
    .problem-card.hidden {
      display: none;
    }
    
    .algorithm-filters {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #e9ecef;
    }
    
    .algorithm-buttons {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    
    .algo-filter-btn {
      padding: 6px 12px;
      border: 1px solid #dee2e6;
      background: white;
      color: #495057;
      border-radius: 16px;
      cursor: pointer;
      font-size: 0.8em;
      transition: all 0.2s;
    }
    
    .algo-filter-btn:hover {
      border-color: #667eea;
      color: #667eea;
      background: #f8f9ff;
    }
    
    .algo-filter-btn.active {
      background: #667eea;
      border-color: #667eea;
      color: white;
    }
    
    .algo-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 10px;
      margin-top: auto;
    }
    
    .algo-tag {
      padding: 4px 8px;
      background: #e9ecef;
      color: #495057;
      border-radius: 12px;
      font-size: 0.75em;
      border: 1px solid #dee2e6;
    }
    
    .filter-btn.selected {
      background: #667eea;
      border-color: #667eea;
      color: white;
    }
    
    .algo-filter-btn.selected {
      background: #667eea;
      border-color: #667eea;
      color: white;
    }

    /* Modal Styles */
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(5px);
    }

    .modal-content {
      background-color: white;
      margin: 5% auto;
      padding: 0;
      border-radius: 12px;
      width: 90%;
      max-width: 600px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      animation: modalSlideIn 0.3s ease-out;
      overflow: hidden;
    }

    @keyframes modalSlideIn {
      from {
        opacity: 0;
        transform: translateY(-50px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modal-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 20px 30px;
      border-radius: 12px 12px 0 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-title {
      margin: 0;
      font-size: 1.5em;
      font-weight: 600;
    }

    .close {
      color: white;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
      line-height: 1;
      transition: opacity 0.2s;
    }

    .close:hover {
      opacity: 0.7;
    }

    .modal-body {
      padding: 30px;
      overflow: hidden;
      max-width: 100%;
    }

    .problem-info {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
      border-left: 4px solid #667eea;
    }

    .problem-info h3 {
      margin: 0 0 10px 0;
      color: #333;
    }

    .problem-meta {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      margin-bottom: 15px;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 5px;
      color: #6c757d;
      font-size: 0.9em;
    }

    .notes-form {
      margin-top: 20px;
      max-width: 100%;
      overflow: hidden;
    }

    .notes-label {
      display: block;
      margin-bottom: 10px;
      font-weight: 600;
      color: #333;
    }

    .notes-textarea {
      width: 100%;
      min-height: 150px;
      padding: 15px;
      border: 2px solid #e9ecef;
      border-radius: 8px;
      font-family: inherit;
      font-size: 1em;
      line-height: 1.6;
      resize: vertical;
      transition: border-color 0.2s;
      box-sizing: border-box;
      overflow-x: hidden;
      word-wrap: break-word;
      max-width: 100%;
    }

    .notes-textarea:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .modal-actions {
      display: flex;
      gap: 15px;
      justify-content: flex-end;
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid #e9ecef;
    }

    .btn {
      padding: 12px 24px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 1em;
      font-weight: 500;
      transition: all 0.2s;
    }

    .btn-primary {
      background: #667eea;
      color: white;
    }

    .btn-primary:hover {
      background: #5a6fd8;
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: #6c757d;
      color: white;
    }

    .btn-secondary:hover {
      background: #5a6268;
    }

    .btn-success {
      background: #28a745;
      color: white;
    }

    .btn-success:hover {
      background: #218838;
    }

    .loading {
      opacity: 0.6;
      pointer-events: none;
    }

    .success-message {
      background: #d4edda;
      color: #155724;
      padding: 15px;
      border-radius: 6px;
      margin-bottom: 20px;
      border: 1px solid #c3e6cb;
      display: none;
    }



    /* Markdown Content Styling */
    .markdown-content {
      line-height: 1.6;
      color: #333;
      height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      word-wrap: break-word;
      max-width: 100%;
    }

    .markdown-content h1,
    .markdown-content h2,
    .markdown-content h3,
    .markdown-content h4,
    .markdown-content h5,
    .markdown-content h6 {
      margin: 20px 0 10px 0;
      color: #2c3e50;
      font-weight: 600;
    }

    .markdown-content h1 { font-size: 1.5em; }
    .markdown-content h2 { font-size: 1.3em; }
    .markdown-content h3 { font-size: 1.1em; }

    .markdown-content p {
      margin: 10px 0;
    }

    .markdown-content ul,
    .markdown-content ol {
      margin: 10px 0;
      padding-left: 20px;
    }

    .markdown-content li {
      margin: 5px 0;
    }

    .markdown-content code {
      background: #f8f9fa;
      padding: 2px 6px;
      border-radius: 4px;
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
      font-size: 0.9em;
      color: #e83e8c;
    }

    .markdown-content pre {
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 6px;
      padding: 15px;
      overflow-x: auto;
      margin: 15px 0;
      max-width: 100%;
      word-wrap: break-word;
    }

    .markdown-content pre code {
      background: none;
      padding: 0;
      color: #333;
    }

    .markdown-content blockquote {
      border-left: 4px solid #667eea;
      margin: 15px 0;
      padding: 10px 20px;
      background: #f8f9fa;
      font-style: italic;
      color: #6c757d;
    }

    .markdown-content strong,
    .markdown-content b {
      font-weight: 600;
      color: #2c3e50;
    }

    .markdown-content em,
    .markdown-content i {
      font-style: italic;
      color: #6c757d;
    }

    .markdown-content a {
      color: #667eea;
      text-decoration: none;
    }

    .markdown-content a:hover {
      text-decoration: underline;
    }

    .markdown-content table {
      border-collapse: collapse;
      width: 100%;
      margin: 15px 0;
      max-width: 100%;
      overflow-x: auto;
      display: block;
    }

    .markdown-content th,
    .markdown-content td {
      border: 1px solid #dee2e6;
      padding: 8px 12px;
      text-align: left;
    }

    .markdown-content th {
      background: #f8f9fa;
      font-weight: 600;
    }
    /* Responsive */
    @media (max-width: 768px) {
      .main-content {
        margin-left: 0;
        padding: 20px;
      }

      .top-bar {
        left: 0;
      }

      .sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="dashboard-layout">
    <!-- Sidebar -->
    <nav class="sidebar">
      <a href="/dashboard" class="sidebar-icon" title="Dashboard">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
        </svg>
      </a>
      <a href="/problems" class="sidebar-icon active" title="Problems">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </a>
      <a href="/logout" class="sidebar-icon" title="Logout">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.59L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
        </svg>
      </a>
    </nav>

    <!-- Top Bar -->
    <div class="top-bar">
      <div class="user-menu">
        <div class="user-avatar">
          <%= (@user.leetcode_username || @user.email).first.upcase %>
        </div>
        <span><%= @user.leetcode_username || @user.email %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 10l5 5 5-5z"/>
        </svg>
      </div>
    </div>

    <!-- Main Content -->
    <main class="main-content" style="margin-top: 60px;">
      <div class="header">
        <h1>Solved Problems</h1>
        <p>Track your progress and add notes to your solved problems</p>
      </div>

      <!-- Stats Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number"><%= @solved_problems.length %></div>
          <div class="stat-label">Total Solved</div>
          <div class="stat-description">All problems completed</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-number"><%= @solved_problems.count { |p| p[:difficulty] == 'Easy' } %></div>
          <div class="stat-label">Easy Problems</div>
          <div class="stat-description">Beginner level</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-number"><%= @solved_problems.count { |p| p[:difficulty] == 'Medium' } %></div>
          <div class="stat-label">Medium Problems</div>
          <div class="stat-description">Intermediate level</div>
        </div>
        
        <div class="stat-card featured">
          <div class="stat-number"><%= @solved_problems.count { |p| p[:difficulty] == 'Hard' } %></div>
          <div class="stat-label">Hard Problems</div>
          <div class="stat-description">Advanced level</div>
          <button class="view-button" onclick="syncProblems()">Sync →</button>
        </div>
      </div>

      <!-- Problems Section -->
      <div class="section">
        <div class="section-header">
          <h2 class="section-title">Your Solved Problems</h2>
          <button class="btn btn-primary" onclick="syncProblems()">Sync Data</button>
        </div>
      
      <div style="margin-bottom: 20px; padding: 15px; background: #e7f3ff; border-radius: 8px; border-left: 4px solid #007bff;">
        <p style="margin: 0; color: #004085; font-size: 0.9em;">
          <strong>Note:</strong> This page shows all problems you've solved on LeetCode. 
          <br>Data is synced from your LeetCode account. Click "Sync" to refresh.
          <br><strong>Click on any problem card to add or edit notes!</strong>
        </p>
      </div>
      
              <!-- Search and Filter Section -->
        <div class="search-section">
          <div class="search-box">
            <input type="text" id="searchInput" placeholder="Search problems..." class="search-input">
            <button id="clearFilters" class="clear-filters-btn">Clear All Filters</button>
          </div>
          

        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="all">All (<span id="allCount"><%= @solved_problems.length %></span>)</button>
          <button class="filter-btn" data-filter="Easy">Easy (<span id="easyCount"><%= @solved_problems.count { |p| p[:difficulty] == 'Easy' } %></span>)</button>
          <button class="filter-btn" data-filter="Medium">Medium (<span id="mediumCount"><%= @solved_problems.count { |p| p[:difficulty] == 'Medium' } %></span>)</button>
          <button class="filter-btn" data-filter="Hard">Hard (<span id="hardCount"><%= @solved_problems.count { |p| p[:difficulty] == 'Hard' } %></span>)</button>
        </div>
        
        <!-- Algorithm Filter Section -->
        <div class="algorithm-filters">
          <h4 style="margin: 15px 0 10px 0; color: #333;">Algorithm Types (Click multiple to combine):</h4>
          <div class="algorithm-buttons">
            <button class="algo-filter-btn active" data-algorithm="all">
              Show All (<span class="algo-count"><%= @solved_problems.length %></span>)
            </button>
            <% 
              all_algorithms = @solved_problems.flat_map { |p| p[:algorithms] || [] }.uniq.sort
              all_algorithms.each do |algo|
                count = @solved_problems.count { |p| (p[:algorithms] || []).include?(algo) }
            %>
              <button class="algo-filter-btn" data-algorithm="<%= algo %>">
                <%= algo %> (<span class="algo-count"><%= count %></span>)
              </button>
            <% end %>
          </div>
        </div>
      </div>
      
      <% if @solved_problems.any? %>
        <div class="problems-grid">
          <% @solved_problems.each do |problem| %>
            <div class="problem-card" data-problem-id="<%= problem[:id] || problem[:title].parameterize %>" data-problem-title="<%= problem[:title] %>" data-problem-difficulty="<%= problem[:difficulty] || 'Unknown' %>" data-problem-notes="<%= problem[:notes] || '' %>">
              <div class="problem-header">
                <div style="flex: 1; min-width: 0;">
                  <a href="<%= problem[:url] %>" target="_blank" class="problem-title" onclick="event.stopPropagation();">
                    <%= problem[:title] %>
                  </a>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
                  <span class="difficulty-badge difficulty-<%= problem[:difficulty]&.downcase %>" data-difficulty="<%= problem[:difficulty] || 'Unknown' %>">
                    <%= problem[:difficulty] || 'Unknown' %>
                  </span>
                  <a href="/problems/<%= problem[:id] %>" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.8em; text-decoration: none;" onclick="event.stopPropagation();">
                    <i class="fas fa-external-link-alt"></i>
                  </a>
                </div>
              </div>
              

              
              <div class="notes-section">
                <div class="notes-title">
                  <span>Notes</span>
                </div>
                <div class="notes-content">
                  <% if problem[:notes] && !problem[:notes].empty? %>
                    <div class="markdown-content">
                      <%= markdown_to_html(problem[:notes]) %>
                    </div>
                  <% else %>
                    <em>No notes added yet. Click the problem card to add notes!</em>
                  <% end %>
                </div>
              </div>
              
              <!-- Algorithm Tags -->
              <% if problem[:algorithms] && problem[:algorithms].any? %>
                <div class="algo-tags">
                  <% problem[:algorithms].each do |algo| %>
                    <span class="algo-tag"><%= algo %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <h3>No solved problems found</h3>
          <p>Click the sync button above to fetch your solved problems from LeetCode.</p>
        </div>
      <% end %>
      </div>
    </main>
  </div>

      <!-- Notes Modal -->
  <div id="notesModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">Problem Notes</h2>
        <div style="display: flex; align-items: center; gap: 15px;">
          <a href="#" id="expandProblemBtn" class="btn btn-primary" style="padding: 8px 16px; font-size: 0.9em; text-decoration: none;">
            <i class="fas fa-external-link-alt"></i>
          </a>
          <span class="close">&times;</span>
        </div>
      </div>
      <div class="modal-body">
        <div class="success-message" id="successMessage">
          Notes saved successfully!
        </div>
        
        <div class="problem-info">
          <h3 id="modalProblemTitle"></h3>
          <div class="problem-meta">
            <div class="meta-item">
              <span>Difficulty</span>
              <span id="modalProblemDifficulty"></span>
            </div>
          </div>
        </div>
        
        <form class="notes-form" id="notesForm">
          <label for="notesTextarea" class="notes-label">Your Notes (Markdown Supported):</label>
          <textarea 
            id="notesTextarea" 
            class="notes-textarea" 
            placeholder="# Problem Notes&#10;&#10;## Key Insights&#10;• Use hash table for O(n) solution&#10;• Two pointer approach also works&#10;&#10;## Time Complexity&#10;- **Best Case:** O(n)&#10;- **Space:** O(n)&#10;&#10;## Code Example&#10;```python&#10;def two_sum(nums, target):&#10;    seen = {}&#10;    for i, num in enumerate(nums):&#10;        complement = target - num&#10;        if complement in seen:&#10;            return [seen[complement], i]&#10;        seen[num] = i&#10;    return []&#10;```&#10;&#10;## What I Learned&#10;Always consider hash table for lookup problems!"
          ></textarea>
          
          <div class="modal-actions">
            <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="saveBtn">Save Notes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  
  <script>
    // Modal functionality
    const modal = document.getElementById('notesModal');
    const closeBtn = document.querySelector('.close');
    const cancelBtn = document.getElementById('cancelBtn');
    const notesForm = document.getElementById('notesForm');
    const notesTextarea = document.getElementById('notesTextarea');
    const successMessage = document.getElementById('successMessage');
    const expandProblemBtn = document.getElementById('expandProblemBtn');
    
    let currentProblemId = null;
    
    // Close modal when clicking on X or Cancel
    closeBtn.onclick = function() {
      modal.style.display = "none";
    }
    
    cancelBtn.onclick = function() {
      modal.style.display = "none";
    }
    
    // Close modal when clicking outside of it
    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
    
    // Close modal with Escape key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && modal.style.display === 'block') {
        modal.style.display = "none";
      }
    });
    
    // Handle expand button click
    expandProblemBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (currentProblemId) {
        window.open(`/problems/${currentProblemId}`, '_blank');
      }
    });
    
    // Make problem cards clickable
    document.addEventListener('DOMContentLoaded', function() {
      const problemCards = document.querySelectorAll('.problem-card');
      
      problemCards.forEach(card => {
        card.addEventListener('click', function(e) {
          // Don't open modal if clicking on the title link
          if (e.target.classList.contains('problem-title')) {
            return;
          }
          
          openNotesModal(this);
        });
      });


    });
    
    function openNotesModal(problemCard) {
      const problemId = problemCard.dataset.problemId;
      const problemTitle = problemCard.dataset.problemTitle;
      const problemDifficulty = problemCard.dataset.problemDifficulty;
      const problemNotes = problemCard.dataset.problemNotes;
      
      // Set modal content
      document.getElementById('modalProblemTitle').textContent = problemTitle;
      document.getElementById('modalProblemDifficulty').textContent = problemDifficulty;
      notesTextarea.value = problemNotes;
      
      currentProblemId = problemId;
      
      // Show modal
      modal.style.display = "block";
      notesTextarea.focus();
      
      // Hide success message
      successMessage.style.display = "none";
    }
    
    // Handle form submission
    notesForm.addEventListener('submit', function(e) {
      e.preventDefault();
      saveNotes();
    });
    
    // Simple markdown to HTML converter for client-side updates
    function convertMarkdownToHtml(markdown) {
      if (!markdown) return '';
      
      return markdown
        // Headers
        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
        .replace(/^## (.*$)/gim, '<h2>$1</h2>')
        .replace(/^# (.*$)/gim, '<h1>$1</h1>')
        // Bold and italic
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        // Code blocks
        .replace(/```(\w+)?\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        // Lists
        .replace(/^\* (.*$)/gim, '<li>$1</li>')
        .replace(/^- (.*$)/gim, '<li>$1</li>')
        .replace(/^(\d+)\. (.*$)/gim, '<li>$2</li>')
        // Links
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
        // Line breaks
        .replace(/\n/g, '<br>');
    }

    function saveNotes() {
      const notes = notesTextarea.value.trim();
      const saveBtn = document.getElementById('saveBtn');
      const originalText = saveBtn.textContent;
      
      // Show loading state
      saveBtn.textContent = 'Saving...';
      saveBtn.disabled = true;
      notesTextarea.disabled = true;
      
      // Make API call to save notes
      fetch('/api/v1/problems/notes', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
        },
        body: JSON.stringify({
          problem_id: currentProblemId,
          problem_title: document.getElementById('modalProblemTitle').textContent,
          notes: notes
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Show success message
          successMessage.style.display = "block";
          
                     // Update the problem card's notes
           const problemCard = document.querySelector(`[data-problem-id="${currentProblemId}"]`);
           if (problemCard) {
             problemCard.dataset.problemNotes = notes;
             const notesContent = problemCard.querySelector('.notes-content');
             if (notesContent) {
               if (notes && notes.trim()) {
                 // Convert markdown to HTML for display
                 const markdownHtml = convertMarkdownToHtml(notes);
                 notesContent.innerHTML = `<div class="markdown-content">${markdownHtml}</div>`;
               } else {
                 notesContent.innerHTML = '<em>No notes added yet. Click the problem card to add notes!</em>';
               }
             }
           }
          
          // Reset form and close modal after a delay
          setTimeout(() => {
            modal.style.display = "none";
            notesForm.reset();
          }, 1500);
        } else {
          alert('Error saving notes: ' + (data.error || 'Unknown error'));
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Error saving notes. Please try again.');
      })
      .finally(() => {
        // Reset button state
        saveBtn.textContent = originalText;
        saveBtn.disabled = false;
        notesTextarea.disabled = false;
      });
    }
    
    function syncProblems() {
      // This would call the sync endpoint to refresh problems
      location.reload();
    }
    
    // Search and filter functionality
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchInput');
      const filterButtons = document.querySelectorAll('.filter-btn');
      const algoFilterButtons = document.querySelectorAll('.algo-filter-btn');
      const problemCards = document.querySelectorAll('.problem-card');
      const clearFiltersBtn = document.getElementById('clearFilters');
      
      let currentFilters = ['all'];
      let currentSearch = '';
      let currentAlgoFilters = ['all'];
      
      // Initialize the "All" filter as active
      const allFilterBtn = document.querySelector('[data-filter="all"]');
      if (allFilterBtn) {
        allFilterBtn.classList.add('active');
      }
      
      // Initialize the "Show All" algorithm filter as active
      const allAlgoFilterBtn = document.querySelector('[data-algorithm="all"]');
      if (allAlgoFilterBtn) {
        allAlgoFilterBtn.classList.add('active');
      }
      
      // Search functionality
      searchInput.addEventListener('input', function() {
        currentSearch = this.value.toLowerCase();
        filterProblems();
      });
      
      // Difficulty filter functionality
      filterButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          const filterValue = this.getAttribute('data-filter');
          
          if (filterValue === 'all') {
            // If "All" is clicked, reset to only "All"
            currentFilters = ['all'];
            filterButtons.forEach(btn => btn.classList.remove('active', 'selected'));
            this.classList.add('active');
          } else {
            // Remove "all" from current filters
            currentFilters = currentFilters.filter(f => f !== 'all');
            
            if (currentFilters.includes(filterValue)) {
              // Remove this filter
              currentFilters = currentFilters.filter(f => f !== filterValue);
              this.classList.remove('selected');
              if (currentFilters.length === 0) {
                // If no filters selected, default to "all"
                currentFilters = ['all'];
                const allBtn = document.querySelector('[data-filter="all"]');
                if (allBtn) {
                  allBtn.classList.remove('active');
                  allBtn.classList.add('active');
                }
              }
            } else {
              // Add this filter
              currentFilters.push(filterValue);
              this.classList.add('selected');
              // Remove "all" button active state
              const allBtn = document.querySelector('[data-filter="all"]');
              if (allBtn) {
                allBtn.classList.remove('active');
              }
            }
          }
          
          filterProblems();
        });
      });
      
      // Algorithm filter functionality
      algoFilterButtons.forEach(button => {
        button.addEventListener('click', function() {
          const algoValue = this.getAttribute('data-algorithm');
          
          if (algoValue === 'all') {
            // If "Show All" is clicked, reset to only "all"
            currentAlgoFilters = ['all'];
            algoFilterButtons.forEach(btn => btn.classList.remove('active', 'selected'));
            this.classList.add('active');
          } else {
            // Remove "all" from current filters
            currentAlgoFilters = currentAlgoFilters.filter(f => f !== 'all');
            
            if (currentAlgoFilters.includes(algoValue)) {
              // Remove this filter
              currentAlgoFilters = currentAlgoFilters.filter(f => f !== algoValue);
              this.classList.remove('selected');
              if (currentAlgoFilters.length === 0) {
                // If no filters selected, default to "all"
                currentAlgoFilters = ['all'];
                document.querySelector('[data-algorithm="all"]').classList.add('active');
              }
            } else {
              // Add this filter
              currentAlgoFilters.push(algoValue);
              this.classList.add('selected');
              // Remove "Show All" button active state
              document.querySelector('[data-algorithm="all"]').classList.remove('active');
            }
          }
          
          filterProblems();
        });
      });
      
      // Clear all filters functionality
      clearFiltersBtn.addEventListener('click', function() {
        // Reset search input
        searchInput.value = '';
        currentSearch = '';
        
        // Reset difficulty filters
        filterButtons.forEach(btn => btn.classList.remove('active', 'selected'));
        document.querySelector('[data-filter="all"]').classList.add('active');
        currentFilters = ['all'];
        
        // Reset algorithm filters
        algoFilterButtons.forEach(btn => btn.classList.remove('active', 'selected'));
        document.querySelector('[data-algorithm="all"]').classList.add('active');
        currentAlgoFilters = ['all'];
        
        // Show all problems
        filterProblems();
      });
      
      function filterProblems() {
        problemCards.forEach(card => {
          const title = card.querySelector('.problem-title').textContent.toLowerCase();
          const difficulty = card.querySelector('.difficulty-badge').getAttribute('data-difficulty');
          const algorithms = Array.from(card.querySelectorAll('.algo-tag')).map(tag => tag.textContent);
          
          const matchesSearch = title.includes(currentSearch);
          const matchesDifficultyFilter = currentFilters.includes('all') || currentFilters.includes(difficulty);
          const matchesAlgoFilter = currentAlgoFilters.includes('all') || currentAlgoFilters.some(filter => algorithms.includes(filter));
          
          if (matchesSearch && matchesDifficultyFilter && matchesAlgoFilter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
        
        updateCounts();
      }
      
      function updateCounts() {
        const visibleCards = document.querySelectorAll('.problem-card:not(.hidden)');
        const allCount = document.getElementById('allCount');
        const easyCount = document.getElementById('easyCount');
        const mediumCount = document.getElementById('mediumCount');
        const hardCount = document.getElementById('hardCount');
        
        if (allCount) allCount.textContent = visibleCards.length;
        if (easyCount) easyCount.textContent = Array.from(visibleCards).filter(card => card.querySelector('.difficulty-badge').getAttribute('data-difficulty') === 'Easy').length;
        if (mediumCount) mediumCount.textContent = Array.from(visibleCards).filter(card => card.querySelector('.difficulty-badge').getAttribute('data-difficulty') === 'Medium').length;
        if (hardCount) hardCount.textContent = Array.from(visibleCards).filter(card => card.querySelector('.difficulty-badge').getAttribute('data-difficulty') === 'Hard').length;
      }
    });
  </script>
</body>
</html>
