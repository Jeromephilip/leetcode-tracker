<!DOCTYPE html>
<html>
<head>
  <title>LeetCode Tracker - Home</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .container {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      padding: 40px;
      text-align: center;
      max-width: 500px;
      width: 90%;
    }
    
    .logo {
      font-size: 2.5em;
      font-weight: bold;
      color: #667eea;
      margin-bottom: 20px;
    }
    
    .welcome-message {
      color: #6c757d;
      margin-bottom: 30px;
      line-height: 1.6;
    }
    
    .flash-messages {
      margin-bottom: 30px;
    }
    
    .flash-notice {
      background: #d4edda;
      color: #155724;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 10px;
      border: 1px solid #c3e6cb;
    }
    
    .flash-alert {
      background: #f8d7da;
      color: #721c24;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 10px;
      border: 1px solid #f5c6cb;
    }
    
    .auth-section {
      margin-bottom: 30px;
    }
    
    .auth-section h4 {
      color: #333;
      margin-bottom: 15px;
    }
    
    .auth-section p {
      color: #6c757d;
      margin-bottom: 20px;
    }
    
    .btn {
      display: inline-block;
      padding: 12px 24px;
      background: #667eea;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      transition: all 0.3s ease;
      margin: 0 10px;
      font-weight: 500;
    }
    
    .btn:hover {
      background: #5a6fd8;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
    
    .btn-secondary {
      background: #6c757d;
    }
    
    .btn-secondary:hover {
      background: #5a6268;
    }
    
    .btn-success {
      background: #28a745;
    }
    
    .btn-success:hover {
      background: #218838;
    }
    
    .features {
      margin-top: 40px;
      padding-top: 30px;
      border-top: 1px solid #e9ecef;
    }
    
    .features h3 {
      color: #333;
      margin-bottom: 20px;
    }
    
    .feature-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    .feature-list li {
      color: #6c757d;
      margin: 10px 0;
      padding: 8px 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">LeetCode Tracker</div>
    
    <div class="welcome-message">
      Track your LeetCode progress, manage solved problems, and add personal notes to improve your problem-solving skills.
    </div>
    
    <div class="flash-messages">
      <% if flash[:notice] %>
        <div class="flash-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>
      
      <% if flash[:alert] %>
        <div class="flash-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>
    </div>
    
    <% if user_signed_in? %>
      <div class="auth-section">
        <h4>LeetCode Account Linked!</h4>
        <p>Welcome back! You're all set to track your LeetCode progress.</p>
        <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
        <a href="https://leetcode.com" target="_blank" class="btn btn-secondary">Go to LeetCode</a>
        <a href="/logout" class="btn btn-secondary">Logout</a>
      </div>
    <% else %>
      <div class="auth-section">
        <h4>Get Started</h4>
        <p>Sign in to your existing account or create a new one to start tracking your LeetCode journey.</p>
        <a href="/users/sign_in" class="btn btn-primary">Sign In</a>
        <a href="/users/sign_up" class="btn btn-success">Create Account</a>
      </div>
    <% end %>
    
    <div class="features">
      <h3>Features</h3>
      <ul class="feature-list">
        <li>Track solved problems and progress</li>
        <li>Add personal notes and insights</li>
        <li>View submission history</li>
        <li>Monitor your LeetCode ranking</li>
        <li>Sync data automatically</li>
      </ul>
    </div>
  </div>
</body>
</html>
